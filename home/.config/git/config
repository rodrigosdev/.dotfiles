[branch]
	sort = "-committerdate"

[column]
	ui = "auto"

[commit]
	gpgSign = true

[core]
	fsmonitor = true

[fetch]
	prune = true
	writeCommitGraph = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[gpg]
	format = "ssh"

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[rebase]
	updateRefs = true

[rerere]
	enabled = true

[tag]
	gpgSign = true

[user]
	email = "hello@rodrigosantos.dev"
	name = "Rodrigo Santos"
	signingKey = ~/.ssh/id_ed25519.pub